# Copy this file to .env and fill in the values. Never commit .env.

# Which GenAI provider to use: gemini | anthropic
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Milliseconds to wait for the AI provider before using rule-based fallback advice
AI_TIMEOUT_MS=20000

PORT=3000

# Leave empty to allow same-origin only. Set to a full origin to allow it, e.g. https://example.com
CORS_ORIGIN=

# Set to 1 when running behind a reverse proxy (Render, Vercel, Nginx) so rate limiting sees real IPs
TRUST_PROXY=0
